# ============================================================
# SURF Security Companion — dev environment (production: Vault,
# see docs/SECRETS.md). Never commit a filled-in .env.
# ============================================================

# ---- Frontend (baked into the bundle at image BUILD time — rebuild the
#      frontend image after changing any VITE_* value) ----
VITE_OIDC_ISSUER_URL=https://keycloak.local/realms/surf-security
VITE_OIDC_CLIENT_ID=surf-companion-frontend
VITE_API_BASE=https://localhost/api
# Same-origin via nginx (/otel/ -> otel-collector:4318); the collector has no TLS.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=https://localhost/otel

# ---- Backend ----
PORT=8080
NODE_ENV=production
OIDC_ISSUER_URL=https://keycloak.local/realms/surf-security
OIDC_AUDIENCE=surf-companion-backend
# JWKS fetched over plain HTTP inside the Docker network (Node's fetch/undici
# does not honor NODE_EXTRA_CA_CERTS, so the self-signed nginx cert fails).
OIDC_JWKS_URI=http://keycloak:8080/realms/surf-security/protocol/openid-connect/certs
REQUIRED_ROLES=SOC_ANALYST,DSO_OPERATOR,PLATFORM_ADMIN,AUDITOR,EXECUTIVE_OBSERVER
TENANT_CLAIM=surf_tenant_id
REQUEST_ID_HEADER=x-request-id

# ---- Portal DB (Postgres 17) ----
PG_HOST=postgres
PG_PORT=5432
PG_DB=surf_soc
PG_USER=soc_app
PG_PASSWORD=change-me
# Dev Postgres has no server-side TLS configured, so connect without SSL.
PG_SSL=disable

# ---- OpenSearch ----
OPENSEARCH_URL=https://opensearch.local:9200
OPENSEARCH_USERNAME=admin
# Must satisfy OpenSearch's password-strength check (rejects weak values).
OPENSEARCH_PASSWORD=Change-Me-2026!
# Left empty in dev: OpenSearch serves its bundled demo cert (not signed by our
# dev CA), so the backend client falls back to rejectUnauthorized:false.
OPENSEARCH_CA_PATH=

# ---- Wazuh ----
WAZUH_API_URL=https://wazuh.local:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASS=change-me

# ---- MinIO (WORM) ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=surfminio
MINIO_SECRET_KEY=surfminiosecret
MINIO_BUCKET_AUDIT=surf-audit
MINIO_BUCKET_HASHCHAIN=surf-hashchain
MINIO_USE_SSL=false
MINIO_OBJECT_LOCK_YEARS=1

# ---- Hash-chain signing (soft key for MVP; HSM/PKCS#11 in prod) ----
HASHCHAIN_SIGNING_KEY_PATH=/secrets/hashchain-ed25519.key
HASHCHAIN_ROLLUP_INTERVAL_MINUTES=60

# ---- Upstream stubs (SURF Flex + EMS) ----
FLEX_API_URL=https://flex.local/api
FLEX_API_TOKEN=flex-token-dev
EMS_API_URL=https://ems.local/api
EMS_API_TOKEN=ems-token-dev

# ---- Alerting ----
PAGERDUTY_ROUTING_KEY=change-me
SLACK_WEBHOOK_URL=

# ---- SOAR safety ----
PLAYBOOK_DRY_RUN_DEFAULT=true
PLAYBOOK_MASS_ACTION_THRESHOLD=10
PLAYBOOK_REQUIRE_STEPUP=true

# ---- Log-shipper ingest (POST /api/ingest/events — docs/INGEST.md) ----
# Static bearer token for Vector (min 32 chars; generate: openssl rand -hex 32).
# Empty = route registered but answers 503 INGEST_DISABLED.
INGEST_TOKEN=
INGEST_SOURCE_LABEL=vector
INGEST_DEFAULT_TENANT_ID=vnb-saar
INGEST_MAX_BATCH=500
# Optional JSON overriding the demo enrichment reference data (allow-list, geo, …);
# template: observability/enrichment-reference.example.json. Mount it read-only.
# ENRICHMENT_REFERENCE_PATH=/config/enrichment-reference.json

# ---- Observability ----
# Plain HTTP inside the Docker network — the collector has no TLS listener.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=surf-security-companion
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev

# ---- TLS (Nginx) ----
TLS_CERT_PATH=/certs/fullchain.pem
TLS_KEY_PATH=/certs/privkey.pem

# ---- Infra admin passwords (dev only) ----
KC_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
